# Copy to .env for local development (never commit .env)
SUPABASE_JDBC_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-supabase-db-password
JWT_SECRET=replace-with-base64-encoded-32-plus-byte-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=auto
JPA_SHOW_SQL=false

